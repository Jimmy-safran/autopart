												</xs:element>
												<xs:element name="Monday" type="xs:boolean" default="false" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `Monday` element controls if the service window is active on Mondays.</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="Tuesday" type="xs:boolean" default="false" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `Tuesday` element controls if the service window is active on Tuesdays.</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="Wednesday" type="xs:boolean" default="false" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `Wednesday` element controls if the service window is active on Wednesdays.</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="Thursday" type="xs:boolean" default="false" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `Thursday` element controls if the service window is active on Thursdays.</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="Friday" type="xs:boolean" default="false" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `Friday` element controls if the service window is active on Fridays.</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="Saturday" type="xs:boolean" default="false" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `Saturday` element controls if the service window is active on Saturdays.</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="Sunday" type="xs:boolean" default="false" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `Sunday` element controls if the service window is active on Sundays.</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="Duration">
													<xs:annotation>
														<xs:documentation>The `Duration` element defines the duration of the service window.</xs:documentation>
													</xs:annotation>
													<xs:complexType>
														<xs:sequence>
															<xs:element name="StartTime" type="xs:time">
																<xs:annotation>
																	<xs:documentation>The `StartTime` element must contain the time when the service window begins.</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="StopTime" type="xs:time">
																<xs:annotation>
																	<xs:documentation>The `StopTime` element must contain the time when the service window ends.</xs:documentation>
																</xs:annotation>
															</xs:element>
														</xs:sequence>
													</xs:complexType>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
								</xs:choice>
							</xs:complexType>
						</xs:element>
					</xs:choice>
				</xs:complexType>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="TextsType">
		<xs:sequence>
			<xs:element name="Text">
				<xs:annotation>
					<xs:documentation>The `Text` element must contain the text that should be returned to the customer.</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="1"/>
						<xs:maxLength value="1024"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Language">
				<xs:annotation>
					<xs:documentation>The `Language` element must contain the language of the `Text` element.</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="2"/>
						<xs:maxLength value="2"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="BusinessRelationDeleteRequest">
		<xs:annotation>
			<xs:documentation>The `BusinessRelationDeleteRequest` command message deletes one or more business relations.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="BusinessRelationId" type="xs:int" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>The `BusinessRelationId` element(s) must contain the business relation IDs which should be deleted.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Comment">
					<xs:annotation>
						<xs:documentation>The `Comment` element must provide a reason for the deletion of the business relations.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="2"/>
							<xs:maxLength value="100"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="StatusRequest">
		<xs:annotation>
			<xs:documentation>The `StatusRequest` command messages retrieves the response status of a message sent by the sender organization to the TecCom Order system.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="DocumentNumber">
					<xs:annotation>
						<xs:documentation>The `DocumentNumber` element must contain the document number of the sent document or the business transaction ID returned by the TecCom Order web service.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="38"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="GetResponse" type="xs:boolean" default="false">
					<xs:annotation>
						<xs:documentation>The `GetResponse` element specifies whether the actual response business document should also be retrieved from the TecCom Order system.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="BusinessRelationSearchRequest">
		<xs:annotation>
			<xs:documentation>The `BusinessRelationSearchRequest` command message searches and retrieves the business relations the sender has with their business partners. The search results can be limited by certain search criteria.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="BusinessRelationId" type="xs:int" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `BusinessRelationId` element limits the search results to the business relation which has this unique ID in the TecCom Order system.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Status" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `Status` element limits the search results to business relations which have this status in the TecCom Order system.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="Inactive"/>
							<xs:enumeration value="Active"/>
							<xs:enumeration value="Rejected"/>
							<xs:enumeration value="Pending"/>
							<xs:enumeration value="Deleted"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="View" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `View` element controls which view of the business relations should be searched.

A business relation has a buyer side view and a supplier side view, and the numbers between those views can be different.

By default, the value of this element is `Any` in the TecCom Order system.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="Buyer"/>
							<xs:enumeration value="Supplier"/>
							<xs:enumeration value="Any"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="PartnerTecId" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `PartnerTecId` limits the search results to business relations with the business partner to whom this Tec ID is assigned..</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="30"/>
							<xs:maxLength value="32"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="PartnerName1" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `PartnerName1` element limits the search results to business relations with business partners whose names contain the value specified here..

For example, "mustermann" will return business relations with "Autoteile Mustermann GmbH". The search is not case-sensitive.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="35"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BuyerPartyNumber" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `BuyerPartyNumber` element limits the search results to business relations which have the same exact buyer party number in the buyer side view or the supplier side view, depending on the value of the `View` element.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="14"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="SupplierPartyNumber" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `SupplierPartyNumber` element limits the search results to business relations which have the same exact supplier party number in the buyer side view or the supplier side view, depending on the value of the `View` element.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="14"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="SearchType" default="Simple" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `SearchType` element specifies which kind of response should be returned.

The difference between `Simple` and `Extended` is the number of views returned in the response.

`Simple` only returns the command message sender side view, that is, the buyer side view for a buyer or the supplier side view for a supplier.

`Extended`, on the other hand, always returns both views, the buyer side view and the supplier side view.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="Simple"/>
							<xs:enumeration value="Extended"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="LastRequestedDate" type="xs:dateTime" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `LastRequestedDate` element limits the business relations to those  modified or created on or after this date and time.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="MemberUpdate">
		<xs:annotation>
			<xs:documentation>The `MemberUpdate` command message updates the organization data for your own organization.

The organization is always the one with which you authenticated yourself against the TecCom web service when sending the command message.

Note that `MemberUpdate` can't update the `Name1` attribute of your organization.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Name2" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `Name2` element updates the continued name or additional name information of the organization.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="0"/>
							<xs:maxLength value="35"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Street1" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `Street1` element updates the first part of the address of the organization.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="35"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Street2" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `Street2` element updates the second  part of the address of the organization.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="0"/>
							<xs:maxLength value="35"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Zip" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `Zip` element updates the ZIP code of the organization.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="10"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="City" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `City` element updates the city of the organization.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="35"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Phone" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `Phone` element updates the phone number of the organization.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="25"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Fax" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `Fax` element updates the fax number of the organization.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="0"/>
							<xs:maxLength value="25"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Mail" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `Mail` element updates the email address of the organization.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="0"/>
							<xs:maxLength value="254"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="MemberInfoRequest">
		<xs:annotation>
			<xs:documentation>The `MemberInfoRequest` command message retrieves system data for one or more TecCom business partners.

The system data contains the complete membership profile of the business partners (the same information that is visible in the TecCom Portal).</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="PartnerTecId" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>The `PartnerTecId` element(s) must contain the Tec IDs of the business partners for whom you want to retrieve member profiles.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="30"/>
							<xs:maxLength value="32"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="DateOfLastRequest" nillable="false" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `DateOfLastRequest` element limits the results to updates that were done on or after this date and time.

The date and time must be given in the format 'YYYYMMDDhhmm', for example, '202305151459' (15th May 2023, 14:59).</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:length value="12"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="BusinessRelationRequest">
		<xs:annotation>
			<xs:documentation>The `BusinessRelationRequest` command message creates a new business relation in the TecCom Order system between the sender of the command message and a business partner specified by a Tec ID.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="PartnerTecId">
					<xs:annotation>
						<xs:documentation>The `PartnerTecId` element must contain the Tec ID of the business partner.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="30"/>
							<xs:maxLength value="32"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BuyerPartyNumber">
					<xs:annotation>
						<xs:documentation>The `BuyerPartyNumber` element must contain the number of the buyer party.

This is usually the customer number under which the buyer party is known at supplier party side.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="14"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="SupplierPartyNumber">
					<xs:annotation>
						<xs:documentation>The `SupplierPartyNumber` element must contain the number of the supplier party.

This is usually the number under which the supplier party is known at buyer party side.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="14"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="DeliveryParty">
					<xs:annotation>
						<xs:documentation>The `DeliveryParty` element is used for additional routing based on a delivery party number.

This is useful when the same buyer with the same buyer party number has multiple locations identified by multiple delivery party numbers.</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Number" minOccurs="0">
								<xs:annotation>
									<xs:documentation>The `Number` element contains the delivery party number.</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:minLength value="1"/>
										<xs:maxLength value="14"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="IsChecked" type="xs:boolean" default="true">
								<xs:annotation>
									<xs:documentation>The `IsChecked` element controls if the delivery party number should be used for routing.

To forbid a buyer from sending delivery party numbers, the element must be set to the value `false` and the `Number` element must be omitted.</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="Address" type="ContactType" minOccurs="0">
								<xs:annotation>
									<xs:documentation>**Currently Not Used** The `Address` element contains the address associated with the delivery party.</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="InvoicePartyNumber" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `InvoicePartyNumber` element contains the invoice party number.

Including this element can be useful when invoices should be sent to a central instance.

This number is only used for routing invoices.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="14"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="UNBInformation" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `UNBInformation` element contains information for sending of EDIFACT/EANCOM messages.</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Sender">
								<xs:annotation>
									<xs:documentation>The `Sender` element contains interchange information for the sender.</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Identification">
											<xs:annotation>
												<xs:documentation>The `Identification` element must contain the interchange sender identification.</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
													<xs:maxLength value="35"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="CodeQualifier">
											<xs:annotation>
												<xs:documentation>The `CodeQualifier` element must contain the partner identification code qualifier.</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
													<xs:maxLength value="4"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="RoutingAddress" minOccurs="0">
											<xs:annotation>
												<xs:documentation>The `RoutingAddress` contains the sender-specified address for internal routing.</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
													<xs:maxLength value="14"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="Recipient">
								<xs:annotation>
									<xs:documentation>The `Recipient` contains interchange information for the recipient.</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Identification">
											<xs:annotation>
												<xs:documentation>The  Identification` element must contain the interchange recipient identification.</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
													<xs:maxLength value="35"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="CodeQualifier">
											<xs:annotation>
												<xs:documentation>The `CodeQualifier` element must contain the partner identification code qualifier.</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
													<xs:maxLength value="4"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="RoutingAddress" minOccurs="0">
											<xs:annotation>
												<xs:documentation>The `RoutingAddress` element contains the recipient-specified address for internal routing.</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
													<xs:maxLength value="14"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="BusinessRelationUpdateRequest">
		<xs:annotation>
			<xs:documentation>The `BusinessRelationUpdateRequest` command message updates the information of a single business relation. You only need to include the elements that should be updated to contain new values.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="BusinessRelationId" type="xs:int">
					<xs:annotation>
						<xs:documentation>The `BusinessRelationId` element must contain the ID of an existing business relation in the TecCom Order system.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Status" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `Status` element updates the status of the business relation.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="Inactive"/>
							<xs:enumeration value="Active"/>
							<xs:enumeration value="Rejected"/>
							<xs:enumeration value="Pending"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BuyerPartyNumber" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `BuyerPartyNumber` element updates the number of the buyer party. This is usually the customer number under which the buyer party is known at supplier party side.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="14"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="SupplierPartyNumber" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `SupplierPartyNumber` element updates the number of the supplier party. This is usually the number under which the supplier party is known at buyer party side.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="14"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="DeliveryParty" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `DeliveryParty` element updates the additional routing based on a delivery party number.

This is useful when the same buyer with the same buyer party number has multiple locations identified by multiple delivery party numbers.</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Number" minOccurs="0">
								<xs:annotation>
									<xs:documentation>The `Number` element updates the delivery party number.</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:minLength value="1"/>
										<xs:maxLength value="14"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="IsChecked" type="xs:boolean" default="true">
								<xs:annotation>
									<xs:documentation>The `IsChecked` element updates if the delivery party number should be used for routing.

To forbid a buyer from sending delivery party numbers, the element must be set to the value `false` and the `Number` element must be omitted.</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="Address" type="ContactType" minOccurs="0">
								<xs:annotation>
									<xs:documentation>The `Address` element is not currently used.</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="InvoicePartyNumber" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `InvoicePartyNumber` element updates the invoice party number.

Including this element can be useful when invoices should be sent to a central instance.

This number is only used for routing invoices.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="0"/>
							<xs:maxLength value="14"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="UNBInformation" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `UNBInformation` element updates information for sending of EDIFACT/EANCOM messages.</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Sender">
								<xs:annotation>
									<xs:documentation>The `Sender` element updates interchange information for the sender.</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Identification">
											<xs:annotation>
												<xs:documentation>The `Identification` element updates the interchange sender identification.</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
													<xs:maxLength value="35"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="CodeQualifier">
											<xs:annotation>
												<xs:documentation>The `CodeQualifier` element updates the partner identification code qualifier.</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
													<xs:maxLength value="4"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="RoutingAddress" minOccurs="0">
											<xs:annotation>
												<xs:documentation>The `RoutingAddress` element updates the sender-specified address for internal routing.</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
													<xs:maxLength value="14"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="Recipient">
								<xs:annotation>
									<xs:documentation>The `Recipient` contains interchange information for the recipient.</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Identification">
											<xs:annotation>
												<xs:documentation>The  Identification` element updates the interchange recipient identification.</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
													<xs:maxLength value="35"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="CodeQualifier">
											<xs:annotation>
												<xs:documentation>The `CodeQualifier` element updates the partner identification code qualifier.</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
													<xs:maxLength value="4"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="RoutingAddress" minOccurs="0">
											<xs:annotation>
												<xs:documentation>The `RoutingAddress` element updates the recipient-specified address for internal routing.</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
													<xs:maxLength value="14"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="UpdateAllViews" type="xs:boolean" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `UpdateAllViews` element controls if all views should be updated, that is, buyer side view and supplier side view.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="PartnerConfigurationRequest">
		<xs:annotation>
			<xs:documentation>The `PartnerConfigurationRequest` command message retrieves the partner configuration for one or more business partners.

The partner configuration informs you which message types the business partner can receive, and in which formats.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="PartnerTecId" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>The `PartnerTecId` element(s) must contain the Tec IDs of business partners for which the partner configuration should be retrieved.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="30"/>
							<xs:maxLength value="32"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="LastRequestedDate" type="xs:dateTime" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `LastRequestedDate` element limits the partner configurations to those modified or created on or after this date and time.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="LockDestination">
		<xs:annotation>
			<xs:documentation>The `LockDestination` command message locks or unlocks all TomConnect destinations assigned to the command message sender's Tec ID.

Locking destinations has the effect that buyers or suppliers will be unable to send messages to all organizations linked to the TomConnect destinations.

A TomConnect destination in this context means: a web service conforming to the TecOpenMessaging specification to which messages are sent from the TecCom Order system.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="AccessAllowed">
					<xs:annotation>
						<xs:documentation>The `AccessAllowed` element controls whether access to the destination should be allowed (`Yes`) or not allowed (`No`).

Additionally, you can set this to `Maintenance` which will return a special message to a sender stating that the corresponding organization is undergoing maintenance.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="Yes"/>
							<xs:enumeration value="No"/>
							<xs:enumeration value="Maintenance"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Type">
					<xs:annotation>
						<xs:documentation>The `Type` element specifies the type of destination that should be locked.

The value `TecConnect` is not used anymore and will have no effect.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="TecConnect"/>
							<xs:enumeration value="TomConnect"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ServiceWindowUpdateRequest">
		<xs:annotation>
			<xs:documentation>The `ServiceWindowUpdateRequest` command message updates one of your service windows.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ServiceWindowId" type="xs:int">
					<xs:annotation>
						<xs:documentation>The `ServiceWindowId` element must contain the ID of one of your service windows.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Description" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `Description` element contains a text describing what was updated.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="100"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="ServiceWindow" type="ServiceWindowType" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `ServiceWindow` element contains the definition of the service window.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:sequence>
					<xs:element name="Texts" type="TextsType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>The `Texts` element(s) contain texts in different languages that should be returned to the customer when the service window is active.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ServiceWindowCreateRequest">
		<xs:annotation>
			<xs:documentation>The `ServiceWindowCreateRequest` command message creates a service window in the TecCom Order system for the command message sender organization.

A service window defines times during which no messages are sent to the organization of the command message sender, for example, because of an ERP migration or regularly occurring ERP maintenance. Custom texts can be provided to inform the sender about the reason for the service window.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Name">
					<xs:annotation>
						<xs:documentation>The `Name` element must contain the name of the service window.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="50"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Description">
					<xs:annotation>
						<xs:documentation>The `Description` element must contain the description for the service window.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="100"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="ServiceWindow" type="ServiceWindowType">
					<xs:annotation>
						<xs:documentation>The `ServiceWindow` element `must contain the definition of the service window.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:sequence>
					<xs:element name="Texts" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>The `Texts` element(s) contain texts in different languages that should be returned to the customer when the service window is active.</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="TextsType"/>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
				</xs:sequence>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ServiceWindowSearchRequest">
		<xs:annotation>
			<xs:documentation>The `ServiceWindowSearchRequest` command message retrieves your own and/or your business partners' service windows.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Own" type="xs:boolean" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `Own` element controls if your own service windows should be retrieved.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Partners" type="xs:boolean" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `Partners` element controls if your business partners' service windows should be retrieved.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="DestinationStatusRequest">
		<xs:annotation>
			<xs:documentation>The `DestinationStatusRequest` command message retrieves the destination configuration for one of your own Tec IDs.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="TecId">
					<xs:annotation>
						<xs:documentation>The `TecId` element must contain a Tec ID.

It must be identical to the `SenderTecId` used in the `Header` of the command message.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="30"/>
							<xs:maxLength value="32"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="AsyncStatusRequest">
		<xs:annotation>
			<xs:documentation>The `AsyncStatusRequest` command message retrieves the status for one or more asynchronous messages, for example, a Despatch Advice (that is, messages stored in the TecCom Order system for retrieval by the recipient).</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:choice>
					<xs:element name="FromDate" type="xs:date" minOccurs="0">
						<xs:annotation>
							<xs:documentation>The `FromDate` element limits the messages, for which the status is retrieved, to those that were sent at or after the date and time specified here.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:sequence>
						<xs:element name="DocumentNumbers" minOccurs="0">
							<xs:annotation>
								<xs:documentation>The `DocumentNumbers` element is a list of document numbers that can be used to retrieve the statuses of specific documents.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Number" type="xs:string" maxOccurs="25">
										<xs:annotation>
											<xs:documentation>The `Number` element(s) must contain document numbers.</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="TransactionIds" minOccurs="0">
							<xs:annotation>
								<xs:documentation>The `TransactionIds` element is a list of TecCom Order transactions IDs that can be used to retrieve the statuses of specific documents.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Id" type="xs:string" maxOccurs="50">
										<xs:annotation>
											<xs:documentation>The `Id` element(s) must contain TecCom Order transaction IDs.</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="Receiver" minOccurs="0">
							<xs:annotation>
								<xs:documentation>The `Receiver` element is a list of Tec IDs of your partners that can be used to retrieve the statuses of all documents sent to specific partners.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="TecId" maxOccurs="unbounded">
										<xs:annotation>
											<xs:documentation>The `TecId` element(s) must contain Tec IDs.</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:minLength value="30"/>
												<xs:maxLength value="32"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:choice>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="AcceptNotificationRequest">
		<xs:annotation>
			<xs:documentation>The `AcceptNotificationRequest` command message marks one or more messages in the TecCom Order system as retrieved.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:choice>
				<xs:sequence>
					<xs:element name="TransactionId">
						<xs:annotation>
							<xs:documentation>The `TransactionId` element must contain a TecCom Order transaction ID.</xs:documentation>
						</xs:annotation>
						<xs:simpleType>
							<xs:restriction base="xs:string">
								<xs:maxLength value="36"/>
								<xs:minLength value="32"/>
							</xs:restriction>
						</xs:simpleType>
					</xs:element>
				</xs:sequence>
				<xs:sequence maxOccurs="unbounded">
					<xs:element name="DocumentNumber">
						<xs:annotation>
							<xs:documentation>The `DocumentNumber` element(s) must contain document numbers.</xs:documentation>
						</xs:annotation>
						<xs:simpleType>
							<xs:restriction base="xs:string">
								<xs:maxLength value="50"/>
							</xs:restriction>
						</xs:simpleType>
					</xs:element>
				</xs:sequence>
				<xs:sequence maxOccurs="unbounded">
					<xs:element name="MessageId" type="xs:int">
						<xs:annotation>
							<xs:documentation>The `MessageId` element(s) must contain TecCom Order message IDs.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<xs:element name="ServiceWindowDeleteRequest">
		<xs:annotation>
			<xs:documentation>The `ServiceWindowDeleteRequest` command message deletes one of your service windows.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ServiceWindowId" type="xs:int">
					<xs:annotation>
						<xs:documentation>The `ServiceWindowId` element must contain the ID of one of your service windows.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Comment">
					<xs:annotation>
						<xs:documentation>The `Comment` element must contain additional information about why this service window was deleted.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="2"/>
							<xs:maxLength value="100"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="QueuedMessagesRequest" nillable="true">
		<xs:annotation>
			<xs:documentation>The `QueuedMessagesRequest` command message retrieves how many messages your business partners have queued in the TecCom Order system (that is, messages they have not retrieved yet).</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="PartnerTecId" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `PartnerTecId` element limits the retrieval to only those messages you have sent to the business partner with this Tec ID.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="30"/>
							<xs:maxLength value="32"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="BusinessRelationUpdateRequestExtended">
		<xs:annotation>
			<xs:documentation>The `BusinessRelationUpdateRequest` command message updates a business relation.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="BusinessRelationId" type="xs:int">
					<xs:annotation>
						<xs:documentation>The `BusinessRelationId` element must contain the TecCom Order ID of an existing business relation.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Status" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `Status` element updates the status of the business relation.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="Inactive"/>
							<xs:enumeration value="Active"/>
							<xs:enumeration value="Rejected"/>
							<xs:enumeration value="Pending"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BuyerPartyNumber" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `BuyerPartyNumber` element must contain the number of the buyer party.

This is usually the customer number under which the buyer party is known at supplier party side.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="14"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="SupplierPartyNumber" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `SupplierPartyNumber` element must contain the number of the supplier party.

This is usually the number under which the supplier party is known at buyer party side.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="14"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="DeliveryParty" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The `DeliveryParty` element is used for additional routing based on a delivery party number.

