			<xs:documentation xml:lang="en">
			EDI
			Data element: 6411 
			Name: MEASURE UNIT QUALIFIER 
			Source: http://www.unece.org/cefact/codesfortrade/codes_index.html
			Value: 
			CEL Degree celsius 
			CMT Centimetre 
			EA 	Each 
			FAH Degree fahrenheit 
			GRM Gram 
			HUR Hour 
			INH Inch (25,4 mm) 
			KGM Kilogram 
			LTR Litre (1 dm3) 
			MIN Minute 
			MLT Millilitre 
			MMT Millimetre 
			MTK Square metre 
			MTQ Cubic metre 
			MTR Metre 
			NAR Number of articles 
			NRL Number of rolls 
			PCE Piece 
			TNE Metric ton (1000 kg)
