				</xs:simpleType>
			</xs:element>
			<xs:element name="DateTime" nillable="false" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The `DateTime` element contains the date and time when the system data of the TecCom business partner was last updated.

The format is `YYYYMMDDhhmm` (year, month, day, hour, minute).</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
