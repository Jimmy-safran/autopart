						<xs:element name="CompanyDescription" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>The `CompanyDescription` element contains the self-description of the TecCom business partner as a list of texts in different languages.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Language">
										<xs:annotation>
											<xs:documentation>The `Language` element contains the language of the `Text` as a two-letter ISO language code, for example, "de" for German.</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:minLength value="2"/>
												<xs:maxLength value="2"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="Text" nillable="false">
										<xs:annotation>
											<xs:documentation>The `Text` element contains the self-description in the specified `Language`.</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:minLength value="1"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="BuyingGroup" type="xs:string" minOccurs="0">
							<xs:annotation>
								<xs:documentation>The `BuyingGroup` element contains the buying group a TecCom business partner belongs to.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="IdentificationCodes" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>The `IdentificationCodes` element(s) contain codes that uniquely identify the TecCom business partner, for example, GS1 company prefix, VAT number, SIRET number.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Qualifier">
										<xs:annotation>
											<xs:documentation>The `Qualifier` element contains the type of identification code.</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string"/>
										</xs:simpleType>
									</xs:element>
									<xs:element name="Number" nillable="false">
										<xs:annotation>
											<xs:documentation>The `Number` element contains the actual identification code.</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string"/>
										</xs:simpleType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="Contacts" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>The `Contacts` element(s) contain contact information provided by the TecCom business partner.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Type">
										<xs:annotation>
											<xs:documentation>The `Type` element contains the type of the contact.</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="Business"/>
												<xs:enumeration value="Support"/>
												<xs:enumeration value="Technical"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="Name" type="xs:string">
										<xs:annotation>
											<xs:documentation>The `Name` element contains the name of the contact.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="Phone" type="xs:string" minOccurs="0">
										<xs:annotation>
											<xs:documentation>The `Phone` element contains the phone number of the contact.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="Mail" type="xs:string" minOccurs="0">
										<xs:annotation>
											<xs:documentation>The `Mail` element contains the email address of the contact.</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Modules" nillable="false" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The `Modules` element contains detailed information about the configuration, capabilities and restrictions of the TecCom business partner's TecCom modules.

This information is only available for a supplier.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Order" minOccurs="0">
							<xs:annotation>
								<xs:documentation>The `Order` element contains information about the TecCom Order module.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="General" nillable="false" minOccurs="0">
										<xs:annotation>
											<xs:documentation>The `General` element contains general information relating to all Order processes.</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="SupportedUnitOfMeasurements" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `SupportedUnitOfMeasurements` element is a list of units of measurement supported by the TecCom business partner.</xs:documentation>
													</xs:annotation>
													<xs:complexType>
														<xs:sequence>
															<xs:element name="UoM" type="UnitOfMeasurementsType" nillable="false" maxOccurs="unbounded">
																<xs:annotation>
																	<xs:documentation>The `UoM` element(s) contain the units of measurement codes.</xs:documentation>
																</xs:annotation>
															</xs:element>
														</xs:sequence>
													</xs:complexType>
												</xs:element>
												<xs:element name="SupportedCurrencies" nillable="false" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `SupportedCurrencies` element is a list of currencies supported by the TecCom business partner.</xs:documentation>
													</xs:annotation>
													<xs:complexType>
														<xs:sequence>
															<xs:element name="Currency" nillable="false" maxOccurs="unbounded">
																<xs:annotation>
																	<xs:documentation>The `Currency` element(s) contain the currency codes (ISO 4217).</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:string">
																		<xs:minLength value="3"/>
																		<xs:maxLength value="3"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:element>
														</xs:sequence>
													</xs:complexType>
												</xs:element>
												<xs:element name="MaterialHandling" nillable="false" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `MaterialHandling` element contains information relating to material identification.</xs:documentation>
													</xs:annotation>
													<xs:complexType>
														<xs:sequence>
															<xs:element name="MakerCodes" minOccurs="0">
																<xs:annotation>
																	<xs:documentation>The `MakerCodes` element is a list of maker codes supported by the TecCom business partner.</xs:documentation>
																</xs:annotation>
																<xs:complexType>
																	<xs:sequence>
																		<xs:element name="Code" nillable="false" maxOccurs="unbounded">
																			<xs:annotation>
																				<xs:documentation>The `Code` element(s) contain the maker codes.</xs:documentation>
																			</xs:annotation>
																			<xs:simpleType>
																				<xs:restriction base="xs:string">
																					<xs:minLength value="1"/>
																					<xs:maxLength value="6"/>
																				</xs:restriction>
																			</xs:simpleType>
																		</xs:element>
																	</xs:sequence>
																</xs:complexType>
															</xs:element>
															<xs:element name="CustomMakerCodes" minOccurs="0" maxOccurs="unbounded">
																<xs:annotation>
																	<xs:documentation>The `CustomMakerCodes` element(s) contain custom maker codes supported by the TecCom business partner. These codes are not defined by TecCom.</xs:documentation>
																</xs:annotation>
																<xs:complexType>
																	<xs:sequence>
																		<xs:element name="Code">
																			<xs:annotation>
																				<xs:documentation>The `Code` element contains the custom maker code.</xs:documentation>
																			</xs:annotation>
																			<xs:simpleType>
																				<xs:restriction base="xs:string">
																					<xs:minLength value="1"/>
																					<xs:maxLength value="6"/>
																				</xs:restriction>
																			</xs:simpleType>
																		</xs:element>
																		<xs:element name="Description">
																			<xs:annotation>
																				<xs:documentation>The `Description` element contains a description for the custom maker code.</xs:documentation>
																			</xs:annotation>
																			<xs:simpleType>
																				<xs:restriction base="xs:string">
																					<xs:minLength value="1"/>
																					<xs:maxLength value="35"/>
																				</xs:restriction>
																			</xs:simpleType>
																		</xs:element>
																	</xs:sequence>
																</xs:complexType>
															</xs:element>
															<xs:element name="BuyerProductNumberSupport" type="xs:boolean" nillable="false">
																<xs:annotation>
																	<xs:documentation>The `BuyerProductNumberSupport` element states if the TecCom business partner supports buyer product numbers for material identification, that is, if a buyer can in principle order from the partner with their own product numbers.</xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="EANSupport" type="xs:boolean" default="false" nillable="false">
																<xs:annotation>
																	<xs:documentation>The `EANSupport` element states if the TecCom business partner supports EAN codes for material identification.</xs:documentation>
																</xs:annotation>
															</xs:element>
														</xs:sequence>
													</xs:complexType>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="Inquiry" minOccurs="0">
										<xs:annotation>
											<xs:documentation>The `Inquiry` element contains information relating to the inquiry message.</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="AlternativeArticles" type="xs:boolean">
													<xs:annotation>
														<xs:documentation>The `AlternativeArticles` element states if the TecCom business partner can provide alternative articles.</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="ExpressOrder" minOccurs="0">
										<xs:annotation>
											<xs:documentation>The `ExpressOrder` element contains information relating to the express order message.</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="DispatchModes" type="OrderDispatchModesType" maxOccurs="unbounded">
													<xs:annotation>
														<xs:documentation>The `DispatchModes` element(s) contain information about the dispatch modes supported by the TecCom business partner.</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="RequestedDeliveryDateSupport" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `RequestedDeliveryDateSupport` element states if a requested delivery date is supported and, if yes, which kind.

`DeliveryDate` means that the TecCom business partner interprets a requested delivery date as the date on which the goods should be delivered.

`DespatchDate` means that the TecCom business partner interprets a requested delivery date as the date on which the goods should be shipped.</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:enumeration value="DeliveryDate"/>
															<xs:enumeration value="NotSupported"/>
															<xs:enumeration value="DespatchDate"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="DuplicateOrdersAccepted" type="xs:boolean" nillable="false" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `DuplicateOrdersAccepted` element states if duplicate orders are accepted.

Please note that what constitutes a duplicate order is dependent on the TecCom business partner.</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="DeliveryAddressSupport" type="xs:boolean" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `DeliveryAddressSupport` element states if delivery parties are accepted.</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ArticleSubstitution" type="xs:boolean" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `ArticleSubstitution` element states if an automatic article substitution is performed.</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="RequiredFields" type="RequiredFieldsType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `RequiredFields` element contains information about data a buyer must send in the order.</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="SupportedFields" type="SupportedFieldsType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `SupportedFields` element contains information about additional data the TecCom business partner can in principle accept.

It still needs to be agreed with the TecCom business partner what data exactly can be sent and how it needs to be formatted.</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="StockOrder" minOccurs="0">
										<xs:annotation>
											<xs:documentation>The `StockOrder` element contains information relating to the stock order message.</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="RequestedDeliveryDateSupport" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `RequestedDeliveryDateSupport` element states if a requested delivery date is supported and, if yes, which kind.

`DeliveryDate` means that the TecCom business partner interprets a requested delivery date as the date on which the goods should be delivered.

`DespatchDate` means that the TecCom business partner interprets a requested delivery date as the date on which the goods should be shipped.</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:enumeration value="DeliveryDate"/>
															<xs:enumeration value="NotSupported"/>
															<xs:enumeration value="DespatchDate"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="DuplicateOrdersAccepted" type="xs:boolean" nillable="false" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `DuplicateOrdersAccepted` element states if duplicate orders are accepted.

Please note that what constitutes a duplicate order is dependent on the TecCom business partner.</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="DeliveryAddressSupport" type="xs:boolean" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `DeliveryAddressSupport` element states if delivery parties are accepted.</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ArticleSubstitution" type="xs:boolean" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `ArticleSubstitution` element states if an automatic article substitution is performed.</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="RequiredFields" type="RequiredFieldsType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `RequiredFields` element contains information about data a buyer must send in the order.</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="SupportedFields" type="SupportedFieldsType" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `SupportedFields` element contains information about additional data the TecCom business partner can in principle accept.

It still needs to be agreed with the TecCom business partner what data exactly can be sent and how it needs to be formatted.</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="OrdRsp" minOccurs="0">
										<xs:annotation>
											<xs:documentation>**Currently Unsupported** The `OrdRsp` element contains information relating to the order response reverse message.</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="UpdateMessage" type="xs:boolean" nillable="false" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `UpdateMessage` element states if order response updates can be sent.</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="SubstitutionInformation" type="xs:boolean" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `SubstitutionInformation` element states if information related to the substitution of articles can be provided.</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="BuyerProductNumberHandling" type="xs:boolean" nillable="false" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `BuyerProductNumberHandling` element states if buyer product numbers sent in the order can be returned.</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="DesAdv" minOccurs="0">
										<xs:annotation>
											<xs:documentation>**Currently Unsupported** The `DesAdv` element contains information relating to the despatch advice reverse message.</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="PackagingSupport" nillable="false" minOccurs="0" maxOccurs="3">
													<xs:annotation>
														<xs:documentation>The `PackagingSupport` element(s) state how the packaging structure can be represented.

`ItemList`: no packaging structure is provided.

`Nested`: the structure is represented by actual nesting of package nodes inside other package nodes in the XML.

`Hierarchical`: the package nodes are all on the same level and the structure is represented by assigning each package a hierarchy level.</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:enumeration value="ItemList"/>
															<xs:enumeration value="Nested"/>
															<xs:enumeration value="Hierarchical"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="PkgId" nillable="false" minOccurs="0" maxOccurs="3">
													<xs:annotation>
														<xs:documentation>The `PkgId` element states which package identification schemes are supported.

`Supplier`: a supplier-specific number.

`SSID`: serial shipping container code.

`UPC`: universal product code / European article number.</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:enumeration value="Supplier"/>
															<xs:enumeration value="SSID"/>
															<xs:enumeration value="UPC"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="BuyerProductNumberHandling" type="xs:boolean" nillable="false" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `BuyerProductNumberHandling` element states if buyer product numbers sent in the order can be returned.</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="Invoice" minOccurs="0">
										<xs:annotation>
											<xs:documentation>**Currently Unsupported** The `Invoice` element contains information relating to the invoice reverse message.</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="InvoiceModes" nillable="false" minOccurs="0" maxOccurs="2">
													<xs:annotation>
														<xs:documentation>The `InvoiceModes` element(s) state if invoices referencing an Order, invoices referencing a DesAdv, or both can be created.</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:enumeration value="InvoicePerOrder"/>
															<xs:enumeration value="InvoicePerDelivery"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="InvoiceType" nillable="false" minOccurs="0" maxOccurs="unbounded">
													<xs:annotation>
														<xs:documentation>The `InvoiceType` element(s) state what kind of invoices can be created.</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:enumeration value="Invoice"/>
															<xs:enumeration value="CreditNote"/>
															<xs:enumeration value="DebitNote"/>
															<xs:enumeration value="CreditNoteFinancialAdjustments"/>
															<xs:enumeration value="DebitNoteFinancialAdjustments"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="InvoiceVersion" minOccurs="0" maxOccurs="unbounded">
													<xs:annotation>
														<xs:documentation>The `InvoiceVersion` element(s) state which invoice versions can be created.

This refers to a combination of message format and message version.</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:enumeration value="TXML1.0"/>
															<xs:enumeration value="TXML2.5"/>
															<xs:enumeration value="TXML2.5FranceCompliant"/>
															<xs:enumeration value="EdifactCFD96.A"/>
															<xs:enumeration value="EdifactGoldaD96.A"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="PriceDate" nillable="false" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `PriceDate` element states which date is used as the basis of the price calculation.</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:enumeration value="OrderDate"/>
															<xs:enumeration value="DeliveryDate"/>
															<xs:enumeration value="InvoiceDate"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="BuyerProductNumberHandling" type="xs:boolean" nillable="false" minOccurs="0">
													<xs:annotation>
														<xs:documentation>The `BuyerProductNumberHandling` element states if buyer product numbers sent in the order can be returned.</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="BasicSupplyOrganisation" minOccurs="0">
										<xs:annotation>
											<xs:documentation>**Currently Unsupported** The `BasicSupplyOrganization` element contains a Tec ID of an additional Basic Supply organization the TecCom business partner may have.</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="TecId">
													<xs:annotation>
														<xs:documentation>The `TecId` element contains the Tec ID of a TecCom Order organization.</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:minLength value="30"/>
															<xs:maxLength value="32"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="OrderStatusReport" minOccurs="0">
										<xs:annotation>
											<xs:documentation>The `OrderStatusReport` element contains a flag that states if an order status report can be generated.</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="Supported" type="xs:boolean">
													<xs:annotation>
														<xs:documentation>The `Supported` element states if the order status report is supported.</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="TecReturns" minOccurs="0">
							<xs:annotation>
								<xs:documentation>**Currently Unsupported** The `TecReturns` element contains information about the TecCom Returns module.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="OrgName" nillable="false">
										<xs:annotation>
											<xs:documentation>The `OrgName` element contains the name of the associated TecCom Returns organization.</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:minLength value="1"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="TecInvoice" minOccurs="0">
							<xs:annotation>
								<xs:documentation>**Currently Unsupported** The `TecInvoice` element contains information about the TecCom E-Invoicing module.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="OrgName" nillable="false">
										<xs:annotation>
											<xs:documentation>The `OrgName` element contains the name of the associated TecCom E-Invoicing organization.</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:minLength value="1"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="SupportedDocumentContent" nillable="false" minOccurs="0" maxOccurs="unbounded">
										<xs:annotation>
											<xs:documentation>The `SupportedDocumentContent` element(s) state which document formats are supported.</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="Invoice3.0"/>
												<xs:enumeration value="Invoice2.5"/>
												<xs:enumeration value="PaymentInstruction1.0"/>
												<xs:enumeration value="PaymentInstruction2.0"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="TecDoc" minOccurs="0">
							<xs:annotation>
								<xs:documentation>**Currently Unsupported** The `TecDoc` element contains information about the TecDoc solution.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="TecDocProviderID" maxOccurs="unbounded">
										<xs:annotation>
											<xs:documentation>The `TecDocProviderID` element(s) contain the TecDoc provider IDs associated with the TecCom Order organization.</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:minLength value="1"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="TecDocCatalogURL" minOccurs="0">
										<xs:annotation>
											<xs:documentation>The `TecDocCatalogURL` element contains the URL to the TecCom business partner's TecDoc catalogue.</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:minLength value="1"/>
												<xs:maxLength value="2000"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="TecCMD" minOccurs="0">
							<xs:annotation>
								<xs:documentation>**Currently Unsupported** The `TecCMD` element contains information about the TecCom CMD module.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="OrgName" nillable="false">
										<xs:annotation>
											<xs:documentation>The `OrgName` element contains the name of the associated TecCom CMD organization.</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:minLength value="1"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="PriceInfo" type="xs:boolean" minOccurs="0">
										<xs:annotation>
											<xs:documentation>The `PriceInfo` element states if the CMD data contains price information.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="StockInfo" type="xs:boolean">
										<xs:annotation>
											<xs:documentation>The `StockInfo` element states if the CMD data contains stock information.</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="DescriptionTexts" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The `DescriptionTexts` element contains additional information provided by the TecCom business partner.

This information can be of a general nature, like notices on the partner's operations. Or it can further detail the generic options that are presented to the buyer.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Information" nillable="false" minOccurs="0">
							<xs:annotation>
								<xs:documentation>The `Information` element contains an arbitrary informational message in one or more languages.

For example, this could be a message informing the buyer that a new shipping method was added.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Message" type="MessageType" nillable="false" maxOccurs="unbounded">
										<xs:annotation>
											<xs:documentation>The `Message` element(s) contain the informational messages.</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="Urgent" nillable="false" minOccurs="0">
							<xs:annotation>
								<xs:documentation>The `Information` element contains an arbitrary urgent message in one or more languages.

This is most likely a message describing an event that may disrupt the buyer's operations. For example, if there is an ERP outage or the ERP will be offline due to scheduled maintenance.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Message" type="MessageType" nillable="false" maxOccurs="unbounded">
										<xs:annotation>
											<xs:documentation>The `Message` element(s) contain the informational messages.</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="DeliveryDate" nillable="false" minOccurs="0">
							<xs:annotation>
								<xs:documentation>The `DeliveryDate` element contains an arbitrary informational message about the delivery date.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Message" type="MessageType" nillable="false" maxOccurs="unbounded">
										<xs:annotation>
											<xs:documentation>The `Message` element(s) contain the informational messages.</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="DispatchModeInfo" nillable="false" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>The `DispatchModeInfo` element(s) contain information about the dispatch modes offered by the TecCom business partner.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="DispatchMode" nillable="false">
										<xs:annotation>
											<xs:documentation>The `DispatchMode` element contains the dispatch mode.</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="Normal"/>
												<xs:enumeration value="Express"/>
												<xs:enumeration value="OverNight"/>
												<xs:enumeration value="PickUp"/>
												<xs:enumeration value="COD"/>
												<xs:enumeration value="SeaFreight"/>
												<xs:enumeration value="AirFreight"/>
												<xs:enumeration value="StockOrder"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="Message" maxOccurs="unbounded">
										<xs:annotation>
											<xs:documentation>The `Message` element(s) contain the details for the dispatch mode.</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="Language">
													<xs:annotation>
														<xs:documentation>The `Language` element contains the language of the `Text` as a two-letter ISO language code in lowercase, for example, "de" for German.</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:minLength value="2"/>
															<xs:maxLength value="2"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="Text" nillable="false">
													<xs:annotation>
														<xs:documentation>The `Text` element contains the informational text describing the dispatch mode in the specified language.</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:minLength value="1"/>
															<xs:maxLength value="1024"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="AlternateName" type="xs:string">
													<xs:annotation>
														<xs:documentation>The `AlternateName` element contains an alternate name for the dispatch mode.</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="FreeParams" nillable="false" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>The `FreeParams` element(s) contain information about any free parameters the TecCom business partner may support.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="SupportedField" nillable="false">
										<xs:annotation>
											<xs:documentation>The `SupportedField` element contains the free parameter ID.</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="PromotionCode"/>
												<xs:enumeration value="ArrivalNotice"/>
												<xs:enumeration value="Incoterms1"/>
												<xs:enumeration value="Incoterms2"/>
												<xs:enumeration value="StorageLocation"/>
												<xs:enumeration value="CarrierIdILN"/>
												<xs:enumeration value="Spedition"/>
												<xs:enumeration value="FreeText"/>
												<xs:enumeration value="ExpressDlvCond"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="Message" type="MessageType" nillable="false" maxOccurs="unbounded">
										<xs:annotation>
											<xs:documentation>The `Message` element(s) contain the details for the free parameter.</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="UnsupportedRules" nillable="false" minOccurs="0">
				<xs:annotation>
					<xs:documentation>**Currently Unsupported** The `UnsupportedRules` element contains information about business rules which are not supported or fulfilled by the TecCom business partner.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Rule" nillable="false" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>The `Rule` element(s) contain the individual rules.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Number" nillable="false">
										<xs:annotation>
											<xs:documentation>The `Number` element contains the number of the business rule.</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:minLength value="1"/>
												<xs:maxLength value="20"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="MessageType" nillable="false">
										<xs:annotation>
											<xs:documentation>The `MessageType` element contains the message type for which the business rule is unsupported.</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="Inquiry"/>
												<xs:enumeration value="ExpressOrder"/>
												<xs:enumeration value="StockOrder"/>
												<xs:enumeration value="Invoice"/>
												<xs:enumeration value="DespatchAdvise"/>
												<xs:enumeration value="OrderResponse"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="Certification" nillable="false" minOccurs="0">
										<xs:annotation>
											<xs:documentation>The `Certification` element contains information whether this business rule part of the certification process.</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="Version" nillable="false">
													<xs:annotation>
														<xs:documentation>The `Version` element contains the version of the certification process.</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:minLength value="1"/>
															<xs:maxLength value="255"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="Level" nillable="false">
													<xs:annotation>
														<xs:documentation>The `Level` element contains the certification level.</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:enumeration value="Core"/>
															<xs:enumeration value="Standard"/>
															<xs:enumeration value="Enhanced"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="ViolationDescription">
										<xs:annotation>
											<xs:documentation>The `ViolationDescription` element states the reason why this rule was not fulfilled.</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:minLength value="1"/>
												<xs:maxLength value="512"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Response" type="ResponseType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The `Response` element contains the status response for the `MemberInfoRequest` command message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="UnitOfMeasurementsType">
		<xs:annotation>
			<xs:documentation xml:lang="en">
			EDI
			Data element: 6411 
			Name: MEASURE UNIT QUALIFIER 
			Source: http://www.unece.org/cefact/codesfortrade/codes_index.html
			Value: 
			CEL Degree celsius 
			CMT Centimetre 
			EA 	Each 
			FAH Degree fahrenheit 
			GRM Gram 
			HUR Hour 
