			<xs:element name="IsActive" type="xs:boolean" nillable="false" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The `IsActive` element states if the member profile of the TecCom business partner should be used (`true`).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrganisationProfile" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The `OrganisationProfile` element contains general information about the TecCom business partner.

This information is available for both buyers and suppliers.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="OrderManagerModules">
							<xs:annotation>
								<xs:documentation>The `OrderManagerModules` element states which TecCom modules the TecCom business partner uses.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Order" type="xs:boolean" default="false">
										<xs:annotation>
											<xs:documentation>The `Order` element states if the Order module is used.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="eInvoice" type="xs:boolean" default="false">
										<xs:annotation>
											<xs:documentation>The `eInvoice` element states if the e-Invoicing module is used.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ReturnsAndWarranty" type="xs:boolean" default="false">
										<xs:annotation>
											<xs:documentation>The `ReturnsAndWarranty` element states if the Returns and Warranty module is used.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="CMD" type="xs:boolean" default="false">
										<xs:annotation>
											<xs:documentation>The `CMD` element states if the CMD module is used.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="CMI" type="xs:boolean" default="false">
										<xs:annotation>
											<xs:documentation>The `CMI` element states if the CMI module is used.</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="SupportedOrderReverseMessages">
							<xs:annotation>
								<xs:documentation>The `SupportedOrderReverseMessages` element states which reverse message types the TecCom business partner supports.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="OrderResponse" type="xs:boolean" default="false">
										<xs:annotation>
											<xs:documentation>The `OrderResponse` element states if the order response reverse message is supported.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="DespatchAdvise" type="xs:boolean" default="false">
										<xs:annotation>
											<xs:documentation>The `DespatchAdvice` element states if the despatch advice reverse message is supported.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="Invoice" type="xs:boolean" default="false">
										<xs:annotation>
											<xs:documentation>The `Invoice` element states if the invoice reverse message is supported.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="OrderResponseUpdate" type="xs:boolean" default="false">
										<xs:annotation>
											<xs:documentation>The `OrderResponseUpdate` element states if the order response update reverse message is supported.</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
