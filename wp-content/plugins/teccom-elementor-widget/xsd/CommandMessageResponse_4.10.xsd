	<xs:complexType name="ConfigurationType">
		<xs:sequence>
			<xs:element name="CommunicationType" nillable="false" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field describes how the profile owner is connected to the platform</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="TecForm"/>
						<xs:enumeration value="TecOpenMessaging"/>
						<xs:enumeration value="auto-gration"/>
						<xs:enumeration value="Document"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="MessageFormat" nillable="false">
				<xs:annotation>
					<xs:documentation>This field is used to describe which format is used by the profile owner</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="TecForm"/>
						<xs:enumeration value="Txml"/>
						<xs:enumeration value="auto-gration"/>
						<xs:enumeration value="EDIFACT"/>
						<xs:enumeration value="Ansi"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="MessageVersion" nillable="false">
				<xs:annotation>
					<xs:documentation>This field is used to describe which version of the format specified in the field 'MessageFormat' is used by the profile owner</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
