										<xs:maxLength value="32"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="ReceiverTecId" minOccurs="0">
								<xs:annotation>
									<xs:documentation>The `ReceiverTecId` element contains the Tec ID of the message recipient.</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:minLength value="30"/>
										<xs:maxLength value="32"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="DocumentNumber" type="xs:string" minOccurs="0">
								<xs:annotation>
									<xs:documentation>The `DocumentNumber` contains the document number of the message.</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="TransactionId" minOccurs="0">
								<xs:annotation>
									<xs:documentation>The `TransactionId` element contains the ID of the corresponding transaction in the TecCom Order system.</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:minLength value="32"/>
										<xs:maxLength value="38"/>
