							</xs:element>
							<xs:element name="Date" type="xs:dateTime" minOccurs="0">
								<xs:annotation>
									<xs:documentation>The `Date` element contains the date and time when the message was sent.</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="Response" type="ResponseType">
								<xs:annotation>
									<xs:documentation>The `Response` element contains the status of the TecCom order transaction for this message.</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
