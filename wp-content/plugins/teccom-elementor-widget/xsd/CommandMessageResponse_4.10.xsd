									<xs:documentation>The `BusinessRelationChangeHistoryResponse` contains the response payload for the `BusinessRelationChangeHistoryRequest` command message.</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:choice>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
