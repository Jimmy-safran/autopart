				<xs:annotation>
					<xs:documentation>The `Name1` element contains the name of the TecCom business partner.</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="1"/>
						<xs:maxLength value="35"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Logo" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The `Logo` element contains the company logo of the TecCom business partner as a PNG image. The image is provided as a Base64-encoded string.</xs:documentation>
				</xs:annotation>
